# Docs are local working material, except the two shared, durable records.
# Note the `docs/*` form: git cannot re-include a path whose parent directory
# is itself excluded, so `docs/` would make the un-ignores below dead letters.
docs/*
!docs/adr/
!docs/guardrails/

